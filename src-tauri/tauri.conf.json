{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GardenVault",
  "version": "1.0.0-rc.3",
  "identifier": "com.nicolelodeontv.gardenvault",
  "mainBinaryName": "gardenvault",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "GardenVault", "width": 1120, "height": 780, "minWidth": 900, "minHeight": 650, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Offline Gardenscapes profile backup utility",
    "longDescription": "A local-first Windows application for capturing and encrypting Gardenscapes profile snapshots from LDPlayer."
  }
}
